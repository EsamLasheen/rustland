   VALUE "LegalCopyright", "Copyright (c) 2026 EsamLasheen. MIT License.\0"
   VALUE "ProductName", "Monarch Next\0"
   VALUE "ProductVersion", "0.5.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
